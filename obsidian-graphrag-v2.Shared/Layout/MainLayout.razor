@inherits LayoutComponentBase

<div class="app-shell">
    <div class="app-sidebar">
        <div class="brand-header">
            <span class="brand-icon">🔮</span>
            <span class="brand-title">GraphRAG Portal</span>
        </div>
        @WorkspaceSelector
        <NavMenu />
        @if (PortalAccountName is not null)
        {
            <a class="nav-link-custom sidebar-account" href="/account/manage" data-enhance-nav="false">
                <strong>@PortalAccountName</strong>
                <span>Your account</span>
            </a>
        }
    </div>

    <div class="app-content">
        @Body
    </div>
</div>

@code {
    [CascadingParameter(Name = "PortalAccountName")]
    public string? PortalAccountName { get; set; }

    [CascadingParameter(Name = "WorkspaceSelector")]
    public RenderFragment? WorkspaceSelector { get; set; }
}
